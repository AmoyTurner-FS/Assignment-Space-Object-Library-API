<form
  enctype="multipart/form-data"
  method="POST"
  action="/images/{% if image and image.id %}{{ image.id }}{% endif %}">
  {% if image and image.id %}
    <input type="hidden" name="id" value="{{ image.id }}">
  {% endif %}

  <div>
    <label>Title:</label>
    <input type="text" name="title" value="{{ image.title ?? '' }}">
  </div>

  <div>
    <label>Parent Variant:</label>
    <select name="variantId">
      <option>Select Variant...</option>
      {% for variant in variants %}
        <option value="{{ variant.id }}" {% if image and image.variantId == variant.id %}selected="selected"{% endif %}>
          {{ variant.title }}
        </option>
      {% endfor %}
    </select>
  </div>

  <div>
    <label for="image">Upload Image:</label><br>
    <input type="file" name="image" id="image">
  </div>

  <div>
    <button type="submit">Save</button>
  </div>
</form>
