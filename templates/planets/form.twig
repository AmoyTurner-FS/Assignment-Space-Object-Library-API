<form enctype="multipart/form-data" method="POST" action="/planets{% if planet and planet.id %}/{{ planet.id }}?_method=PUT{% endif %}">
{% if planet and planet.id %}<input type="hidden" name="id" value="{{ planet.id }}">{% endif %}
<p><label>Name <input type="text" name="name" value="{{ planet.name ?? '' }}" required></label></p>
<p><label>Type <input type="text" name="type" value="{{ planet.type ?? '' }}" required></label></p>
<p><label>Image <input type="file" name="image" accept="image/*"></label></p>
<p><button type="submit">Save</button> <a href="/planets">Cancel</a></p>
</form>
