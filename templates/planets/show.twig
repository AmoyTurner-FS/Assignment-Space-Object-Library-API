<h1>Planet #{{ planet.id }}</h1>

<p><strong>Name:</strong> {{ planet.name }}</p>
<p><strong>Type:</strong> {{ planet.type }}</p>

<p>
  {% if planet.image %}
    <img src="/uploads/{{ planet.image }}" alt="Planet {{ planet.name }}" width="240">
  {% else %}
    (no uploaded file)
  {% endif %}
</p>

<p>
  <a href="/planets/{{ planet.id }}/edit">Edit</a> |
  <a href="/planets">Back</a>
</p>
