{% extends "../layout.twig" %}
{% block content %}
<p><a href="/planets">&larr; Back</a></p>
<h1>{{ planet.name }}</h1>
<p>Type: {{ planet.type }}</p>
{% if planet.image %}<p><img src="/uploads/{{ planet.image }}" width="240"></p>{% endif %}
<p><a href="/planets/{{ planet.id }}/edit">Edit</a></p>
{% endblock %}
