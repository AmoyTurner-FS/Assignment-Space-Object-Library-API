{% extends "../layout.twig" %}
{% block content %}
<p><a href="/stars">&larr; Back</a></p>
<h1>{{ star.name }}</h1>
<p>Type: {{ star.type }}</p>
<p>Temperature: {{ star.temperature }}</p>
{% if star.image %}<p><img src="/uploads/{{ star.image }}" width="240"></p>{% endif %}
<p><a href="/stars/{{ star.id }}/edit">Edit</a></p>
{% endblock %}
